{
  "name": "babel-plugins",
  "version": "1.0.0",
  "private": true,
  "description": "Custom babel plugins",
  "scripts": {
    "deps": "npm run clean && pnpm install",
    "clean": "rm -rf ./node_modules ./*/*/node_modules",
    "docs:dev": "pnpm run --filter=docs docs:dev",
    "docs:build": "pnpm run --filter=docs docs:build",
    "docs:preview": "pnpm run --filter=docs docs:preview",
    "build:all": "pnpm run -r build",
    "test:all": "pnpm run -r test",
    "release:all": "publish-pkgs packages/* !packages/{demo,docs}",
    "eslint": "eslint --ext .js,.jsx,.ts,.tsx,.mjs --ignore-path .eslintignore ./",
    "eslint:fix": "eslint --ext .js,.jsx,.ts,.tsx,.mjs --fix --ignore-path .eslintignore ./"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengxinming/babel-plugin-jsx-advanced.git"
  },
  "author": "Jesse Feng",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fengxinming/babel-plugin-jsx-advanced/issues"
  },
  "homepage": "https://github.com/fengxinming/babel-plugin-jsx-advanced#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.11.0",
    "@babel/eslint-plugin": "^7.11.0",
    "@babel/preset-env": "^7.11.0",
    "@babel/preset-react": "^8.0.1",
    "@babel/standalone": "^7.29.9",
    "@commitlint/cli": "^19.2.0",
    "@commitlint/config-conventional": "^19.1.0",
    "@stylistic/eslint-plugin": "^3.1.0",
    "@stylistic/eslint-plugin-ts": "^3.1.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.57.0",
    "eslint-config-fe": "^3.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-advanced": "workspace:^",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-vue": "^10.11.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "publish-pkgs": "^1.0.2",
    "react": "^18.2.0",
    "typescript": "6.0.3",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}