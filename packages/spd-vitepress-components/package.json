{
  "name": "spd-vitepress-components",
  "description": "Vitepress theme for single page documentation.",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/node/config.d.ts",
      "import": "./dist/node/config.js"
    },
    "./style.css": "./dist/style/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && tsdown",
    "release": "pnpm publish --no-git-checks"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fengxinming/babel-plugin-jsx-advanced/tree/master/packages/spd-vitepress-theme"
  },
  "keywords": [
    "theme",
    "vitepress-theme",
    "spd"
  ],
  "author": "Jesse Feng <fxm0016@126.com>",
  "license": "MIT",
  "dependencies": {
    "minisearch": "^7.2.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "stylus": "^0.64.0",
    "tsdown": "^0.23.0",
    "vitepress": "2.0.0-alpha.20",
    "vue-sfc-transformer": "^0.3.0",
    "vue-tsc": "^3.3.11"
  },
  "files": [
    "dist"
  ]
}