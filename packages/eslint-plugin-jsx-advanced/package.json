{
  "name": "eslint-plugin-jsx-advanced",
  "version": "2.0.1",
  "description": "A eslint plugin for using babel-plugin-jsx-advanced",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "release": "pnpm publish --no-git-checks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengxinming/babel-plugin-jsx-advanced.git",
    "directory": "packages/eslint-plugin-jsx-advanced"
  },
  "bugs": {
    "url": "https://github.com/fengxinming/babel-plugin-jsx-advanced/issues"
  },
  "homepage": "https://github.com/fengxinming/babel-plugin-jsx-advanced/tree/main/packages/eslint-plugin-jsx-advanced#readme",
  "keywords": [
    "eslint-plugin-jsx-advanced",
    "babel-plugin-jsx-advanced",
    "eslint-plugin"
  ],
  "author": "Jesse Feng <fxm0016@126.com>",
  "license": "MIT",
  "dependencies": {
    "eslint-scope": ">=7.2.2",
    "jsx-ast-utils": "^3.1.0"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.9",
    "@types/estree-jsx": "^1.0.5",
    "@types/jsx-ast-utils": "^3.3.1",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vite-plugin-external": "^8.0.3",
    "vitest": "^5.0.2"
  }
}