{
  "name": "babel-plugin-jsx-advanced",
  "version": "2.0.1",
  "description": "A babel plugin for jsx advanced Features",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "release": "pnpm publish --no-git-checks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengxinming/babel-plugin-jsx-advanced.git",
    "directory": "packages/babel-plugin-jsx-advanced"
  },
  "bugs": {
    "url": "https://github.com/fengxinming/babel-plugin-jsx-advanced/issues"
  },
  "homepage": "https://github.com/fengxinming/babel-plugin-jsx-advanced/tree/main/packages/babel-plugin-jsx-advanced#readme",
  "keywords": [
    "babel",
    "babel-plugin",
    "jsx",
    "directive",
    "babel-plugin-jsx-advanced"
  ],
  "author": "Jesse Feng <fxm0016@126.com>",
  "license": "MIT",
  "peerDependencies": {
    "babel-runtime-jsx-advanced-helper": "workspace:^"
  },
  "peerDependenciesMeta": {
    "babel-runtime-jsx-advanced-helper": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@types/babel__core": "^7.20.5",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vite-plugin-external": "^8.0.3",
    "vitest": "^5.0.2"
  }
}