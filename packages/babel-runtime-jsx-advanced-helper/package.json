{
  "name": "babel-runtime-jsx-advanced-helper",
  "version": "2.0.0",
  "description": "A collection of helpers for babel-plugin-jsx-advanced",
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./class-helper": {
      "types": "./dist/class-helper.d.ts",
      "import": "./dist/class-helper.js",
      "require": "./dist/class-helper.cjs"
    },
    "./for-helper": {
      "types": "./dist/for-helper.d.ts",
      "import": "./dist/for-helper.js",
      "require": "./dist/for-helper.cjs"
    },
    "./show-helper": {
      "types": "./dist/show-helper.d.ts",
      "import": "./dist/show-helper.js",
      "require": "./dist/show-helper.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "prepublishOnly": "npm run build",
    "release": "pnpm publish --no-git-checks"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fengxinming/babel-plugin-jsx-advanced/tree/master/packages/babel-runtime-jsx-advanced-helper"
  },
  "keywords": [
    "babel",
    "babel-plugin",
    "jsx",
    "babel-plugin-jsx-advanced"
  ],
  "author": "Jesse Feng <fxm0016@126.com>",
  "license": "MIT",
  "devDependencies": {
    "classnames": "^2.5.1",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.5"
  }
}